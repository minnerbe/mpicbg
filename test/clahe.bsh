/*
 * Self-contained correctness checks for the Flat CLAHE implementation.
 *
 * Run from Fiji's script editor (Plugins > New > BeanShell, paste & run).
 * Each check asserts an analytical invariant any correct CLAHE must satisfy.
 */
import ij.ImagePlus;
import ij.process.ByteProcessor;
import java.util.Arrays;
import java.util.Random;
import mpicbg.ij.clahe.Flat;
import mpicbg.ij.clahe.Util;

void ok(String what) { System.out.println("OK  " + what); }

void assertClose(String what, float expected, float actual, float eps) {
	if (Float.isNaN(actual) || Math.abs(expected - actual) > eps)
		throw new RuntimeException(what + ": expected " + expected + " got " + actual);
}
void assertClose(String what, float expected, float actual) {
	assertClose(what, expected, actual, 1e-6f);
}

ByteProcessor randomBp(int w, int h, long seed) {
	ByteProcessor bp = new ByteProcessor(w, h);
	Random rng = new Random(seed);
	byte[] px = (byte[]) bp.getPixels();
	rng.nextBytes(px);
	return bp;
}

ByteProcessor ramp(int w, int h, int lo, int hi) {
	ByteProcessor bp = new ByteProcessor(w, h);
	for (int y = 0; y < h; ++y)
		for (int x = 0; x < w; ++x)
			bp.set(x, y, lo + (x * (hi - lo)) / (w - 1));
	return bp;
}

// ---------- Util-level analytical checks --------------------------------

void testUtilTransferUniform() {
	int[] hist = new int[]{1, 1, 1, 1, 1, 1, 1, 1};
	int[] clipped = new int[hist.length];
	int limit = 8; // no clipping
	for (int v = 0; v < hist.length; ++v) {
		float t = Util.transferValue(v, hist, clipped, limit);
		assertClose("uniform transfer at v=" + v, v / 7.0f, t);
	}
	ok("Util.transferValue on uniform histogram");
}

void testUtilTransferBinary() {
	int[] hist = new int[]{10, 0, 0, 0, 0, 0, 0, 10};
	int[] clipped = new int[hist.length];
	int limit = 10;
	for (int v = 0; v < 7; ++v) {
		float t = Util.transferValue(v, hist, clipped, limit);
		assertClose("binary transfer at v=" + v, 0.0f, t);
	}
	float t7 = Util.transferValue(7, hist, clipped, limit);
	assertClose("binary transfer at v=7", 1.0f, t7);
	ok("Util.transferValue on binary histogram");
}

/*
 * Pointwise transferValue must match the bulk LUT produced by createTransfer
 * for every bin, on a non-trivial histogram that exercises the lookahead
 * clipping path.
 */
void testUtilCreateTransferMatchesPointwise() {
	int[] hist = new int[]{100, 0, 0, 0, 5, 5, 5, 0, 0, 0};
	int limit = 20;
	float[] lut = Util.createTransfer(hist, limit);
	int[] clipped = new int[hist.length];
	for (int v = 0; v < hist.length; ++v) {
		float t = Util.transferValue(v, hist, clipped, limit);
		assertClose("createTransfer vs transferValue at v=" + v, lut[v], t);
	}
	ok("Util.createTransfer agrees with Util.transferValue");
}

/*
 * Ramp hist[i] = i with bins odd and limit = (bins-1)/2: deficit of the
 * lower half exactly matches excess of the upper half, so redistribution
 * lands every bin at exactly limit.
 */
void testClipHistogramRampToUniform() {
	int bins = 9;
	int limit = (bins - 1) / 2; // 4
	int[] hist = new int[bins];
	for (int i = 0; i < bins; ++i) hist[i] = i;
	int[] clipped = new int[bins];
	Util.transferValue(0, hist, clipped, limit); // populates `clipped`
	for (int i = 0; i < bins; ++i) {
		if (clipped[i] != limit)
			throw new RuntimeException("expected uniform clipped histogram at " + limit +
					", got " + Arrays.toString(clipped));
	}
	ok("Util.clipHistogram redistributes ramp [0..bins-1] to uniform at limit=(bins-1)/2");
}

// ---------- Pipeline-level analytical check -----------------------------

/*
 * 16x16 image with each grey level 0..255 appearing exactly once; under
 * global blockRadius and no clipping the transfer reduces to v/255 and
 * the output must be byte-identical to the input.
 */
void testGlobalEqualizationOnUniformImageIsIdentity() {
	int w = 16; int h = 16;
	ByteProcessor src = new ByteProcessor(w, h);
	for (int i = 0; i < w * h; ++i) src.set(i, i);
	byte[] before = Arrays.copyOf((byte[]) src.getPixels(), w * h);

	ImagePlus imp = new ImagePlus("uniform", src);
	// blockRadius = max(w,h)-1 is the largest value that still causes
	// addColumn(width-1) to fire; larger values silently drop the
	// rightmost column from the window.
	Flat.getInstance().run(imp, Math.max(w, h) - 1, 256, 1e6f, null, false);

	byte[] after = (byte[]) imp.getProcessor().getPixels();
	for (int i = 0; i < before.length; ++i) {
		if (before[i] != after[i])
			throw new RuntimeException("global eq on uniform image not identity at i=" + i +
					": before=" + (before[i] & 0xff) + " after=" + (after[i] & 0xff));
	}
	ok("Flat global equalization on perfectly uniform image is the identity");
}

// ---------- Structural invariants ---------------------------------------

/*
 * Under global blockRadius every pixel sees the same window histogram, so
 * identical inputs map to identical outputs and the transfer (a CDF) is
 * monotone non-decreasing in the input.
 */
void testMonotonicityWithGlobalBlock() {
	int w = 32; int h = 32;
	ByteProcessor src = randomBp(w, h, 0xC0FFEEL);
	byte[] inputs = Arrays.copyOf((byte[]) src.getPixels(), w * h);

	ImagePlus imp = new ImagePlus("rand", src);
	Flat.getInstance().run(imp, Math.max(w, h) - 1, 256, 4.0f, null, false);
	byte[] outputs = (byte[]) imp.getProcessor().getPixels();

	int[] minOut = new int[256];
	int[] maxOut = new int[256];
	boolean[] seen = new boolean[256];
	Arrays.fill(minOut, 256);
	Arrays.fill(maxOut, -1);
	for (int i = 0; i < inputs.length; ++i) {
		int in = inputs[i] & 0xff;
		int out = outputs[i] & 0xff;
		seen[in] = true;
		if (out < minOut[in]) minOut[in] = out;
		if (out > maxOut[in]) maxOut[in] = out;
	}
	int prev = -1;
	for (int v = 0; v < 256; ++v) {
		if (!seen[v]) continue;
		if (minOut[v] != maxOut[v])
			throw new RuntimeException("input " + v + " maps to multiple outputs under global block");
		if (minOut[v] < prev)
			throw new RuntimeException("monotonicity violated at input " + v +
					": output " + minOut[v] + " < previous " + prev);
		prev = maxOut[v];
	}
	ok("Flat is monotone in input value under global blockRadius");
}

void testDeterminism() {
	ByteProcessor a = randomBp(48, 48, 0xBEEFL);
	ByteProcessor b = (ByteProcessor) a.duplicate();
	ImagePlus impA = new ImagePlus("a", a);
	ImagePlus impB = new ImagePlus("b", b);
	Flat.getInstance().run(impA, 8, 256, 3.0f, null, false);
	Flat.getInstance().run(impB, 8, 256, 3.0f, null, false);
	if (!Arrays.equals((byte[]) impA.getProcessor().getPixels(),
			(byte[]) impB.getProcessor().getPixels()))
		throw new RuntimeException("Flat is not deterministic");
	ok("Flat is deterministic");
}

/*
 * Ramp confined to [lo, hi] under global blockRadius and slope high enough
 * to disable clipping must be stretched to span [0, 255]: the lowest
 * occupied bin lands at 0 (cdf == cdfMin) and the highest at 255.
 */
void testLinearRampSpansFullRange() {
	int w = 64; int h = 64;
	int lo = 50; int hi = 200;
	ByteProcessor src = ramp(w, h, lo, hi);
	ImagePlus imp = new ImagePlus("ramp", src);
	// limit = slope*n/bins = 100*4096/256 = 1600 >> max bin count (h = 64)
	Flat.getInstance().run(imp, Math.max(w, h) - 1, 256, 100.0f, null, false);

	byte[] px = (byte[]) imp.getProcessor().getPixels();
	int min = 255; int max = 0;
	for (int i = 0; i < px.length; ++i) {
		int v = px[i] & 0xff;
		if (v < min) min = v;
		if (v > max) max = v;
	}
	if (min != 0 || max != 255)
		throw new RuntimeException("ramp [" + lo + "," + hi + "] not stretched to full range: " +
				"got [" + min + "," + max + "]");
	ok("Flat stretches a [" + lo + "," + hi + "] ramp to the full [0,255] range");
}

testUtilTransferUniform();
testUtilTransferBinary();
testUtilCreateTransferMatchesPointwise();
testClipHistogramRampToUniform();
testGlobalEqualizationOnUniformImageIsIdentity();
testMonotonicityWithGlobalBlock();
testDeterminism();
testLinearRampSpansFullRange();
System.out.println("All CLAHE correctness checks passed.");
